{
  "name": "rheinagent-file-upload",
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "serve": "tsx server.ts",
    "serve:dataplane": "tsx dataplane.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:dataplane": "node dist/dataplane.js",
    "smoke:seed": "node scripts/runtime-smoke.mjs seed .runtime-smoke-state.json",
    "smoke:verify": "node scripts/runtime-smoke.mjs verify .runtime-smoke-state.json"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "latest",
    "pdfjs-dist": "^5.4.296",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/express": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
